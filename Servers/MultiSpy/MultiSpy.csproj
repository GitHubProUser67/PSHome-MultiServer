<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- "latest" works on local PC but not in build pipeline; Visual Studio version difference? Whatever, preview it is. -->
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileRunArguments>-p 29900:29900 -p 29901:29901 -p 29910:29910 -p 27900:27900 -p 28910:28910 -p 27901:27901 -p 6667:6667 -p 65535:65535</DockerfileRunArguments>
    <ApplicationIcon>MultiSpy.ico</ApplicationIcon>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="none" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="System.Data.SQLite" Version="2.0.2" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AuxiliaryServices\MultiSpyService\MultiSpyService.csproj" />
    <ProjectReference Include="..\..\BackendServices\TechnitiumLibrary.Net.Firewall\TechnitiumLibrary.Net.Firewall.csproj" />
  </ItemGroup>

  <ItemGroup>
    <WeaverFiles Include="..\..\CosturaService\netstandard2.0\Costura.Fody.dll" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="static\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Python_Scripts\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="MultiSpy.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="costura-win-x86\e_sqlite3.dll" />
    <EmbeddedResource Include="costura-win-x64\e_sqlite3.dll" />
    <EmbeddedResource Include="costura-win-arm64\e_sqlite3.dll" />
    <EmbeddedResource Include="costura-osx-x64\libe_sqlite3.dylib" />
    <EmbeddedResource Include="costura-osx-arm64\libe_sqlite3.dylib" />
    <EmbeddedResource Include="costura-linux-x64\libe_sqlite3.so" />
    <EmbeddedResource Include="costura-linux-arm64\libe_sqlite3.so" />
  </ItemGroup>

  <!-- Try to use system Powershell even if on an outdated Windows install, Linux is assumed to be last version always (not bundled with) -->
  <Target Name="ModifyDepsFile" AfterTargets="AfterBuild">
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="cmd /c (where pwsh &gt;nul 2&gt;&amp;1 &amp;&amp; pwsh -ExecutionPolicy Bypass -File &quot;$(ProjectDir)DepsFixer.ps1&quot; -jsonFilePath &quot;$(OutDir)$(ProjectName).deps.json&quot; -targetFramework &quot;$(TargetFramework)&quot;) || (powershell -ExecutionPolicy Bypass -File &quot;$(ProjectDir)DepsFixer.ps1&quot; -jsonFilePath &quot;$(OutDir)$(ProjectName).deps.json&quot; -targetFramework &quot;$(TargetFramework)&quot;)" />

    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProjectDir)DepsFixer.ps1&quot; -jsonFilePath &quot;$(OutDir)$(ProjectName).deps.json&quot; -targetFramework &quot;$(TargetFramework)&quot;" />
  </Target>
</Project>
