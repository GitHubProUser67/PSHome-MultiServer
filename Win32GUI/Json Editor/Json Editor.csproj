<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <!-- "latest" works on local PC but not in build pipeline; Visual Studio version difference? Whatever, preview it is. -->
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Json Editor by ZTn</Product>
    <Description>Simple Json Editor based on Newtonsoft.Json library</Description>
    <Copyright>ZeToken.net 2013-2020 (MIT License)</Copyright>
    <Authors>Sylvain Vernois</Authors>
    <Version>1.6.0</Version>
    <Company>ZeToken.net</Company>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ZTn.Json.Editor</RootNamespace>
    <AssemblyName>ZTn.Json.Editor</AssemblyName>
    <OutputType>WinExe</OutputType>
    <StartupObject>ZTn.Json.Editor.Program</StartupObject>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <ApplicationIcon>json-editor.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="json-editor.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="none" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JsonTreeView\JsonTreeView.csproj" />
  </ItemGroup>
  <ItemGroup>
    <WeaverFiles Include="..\..\CosturaService\netstandard2.0\Costura.Fody.dll" />
  </ItemGroup>
</Project>
