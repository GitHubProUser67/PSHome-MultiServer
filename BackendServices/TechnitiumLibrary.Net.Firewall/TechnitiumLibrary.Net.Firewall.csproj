<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- "latest" works on local PC but not in build pipeline; Visual Studio version difference? Whatever, preview it is. -->
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPublishable>false</IsPublishable>
    <IsTrimmable
      Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))"
      >true</IsTrimmable
    >
    <Version>5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="vocaluxe.dependencies.netfwtypelib" Version="1.0.1" />
  </ItemGroup>
</Project>
